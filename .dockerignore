# Version control and local tooling
.git/
.gitignore
.dockerignore
.agents/
.vscode/

# Secrets and credentials must be mounted or injected at runtime
.env
.env.*
credentials.json
token.json
*service-account*.json

# Python environments and caches
.venv/
**/__pycache__/
**/*.py[cod]
.pytest_cache/

# Files not needed by the application image
runtime-outputs/
runtime/
data/
EDA/
*.sql
README*.md
Dockerfile*
compose*.yml
compose*.yaml
.DS_Store
